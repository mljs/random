{
  "name": "ml-random",
  "version": "2.1.0",
  "description": "Choose randomly from a selection of elements",
  "type": "module",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "check-types": "tsc --noEmit",
    "clean": "rimraf coverage lib",
    "eslint": "eslint .",
    "eslint-fix": "eslint . --fix",
    "prepack": "npm run tsc",
    "prettier": "prettier --check .",
    "prettier-write": "prettier --write .",
    "test": "npm run test-only && npm run check-types && npm run eslint && npm run prettier",
    "test-only": "vitest run --coverage",
    "tsc": "npm run clean && npm run tsc-build",
    "tsc-build": "tsc --project tsconfig.build.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mljs/random.git"
  },
  "keywords": [],
  "author": "Daniel Kostro",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mljs/random/issues"
  },
  "homepage": "https://github.com/mljs/random#readme",
  "dependencies": {
    "ml-xsadd": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^4.1.12",
    "@zakodium/tsconfig": "^1.0.5",
    "eslint": "^10.15.0",
    "eslint-config-cheminfo-typescript": "^23.0.0",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
